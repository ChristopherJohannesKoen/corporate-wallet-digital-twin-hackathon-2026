{
  "policy_version": "mlflow-promotion-policy-1.0.0",
  "registry_uri": "databricks-uc",
  "registered_model_prefix": "wallet_twin.models",
  "aliases": ["candidate", "shadow", "champion", "rollback"],
  "required_artifacts": [
    "model",
    "environment-lock",
    "point-in-time-dataset-manifest",
    "feature-transformation-manifest",
    "prior-manifest",
    "posterior-diagnostics",
    "validation-report",
    "model-card",
    "sbom",
    "container-signature"
  ],
  "promotion_gates": {
    "candidate_to_shadow": [
      "independent_reproduction",
      "zero_point_in_time_leakage",
      "90pct_coverage_between_85pct_and_95pct",
      "crps_improvement_at_least_10pct",
      "no_material_segment_severe_undercoverage"
    ],
    "shadow_to_champion": [
      "all_candidate_to_shadow_gates",
      "approved_e3_calibration_panel",
      "approved_economics",
      "security_and_entitlement_approval",
      "30_elapsed_clean_shadow_days",
      "model_risk_approval"
    ]
  },
  "automatic_promotion": false,
  "automatic_rollback": false,
  "rollback_alias_required": true
}

