{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "dataset_version": {
          "title": "Dataset Version",
          "type": "string"
        },
        "measurement_policy_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measurement Policy Version"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "prior_version": {
          "title": "Prior Version",
          "type": "string"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "rate_card_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate Card Version"
        },
        "schema_version": {
          "default": "v1",
          "title": "Schema Version",
          "type": "string"
        },
        "transformation_version": {
          "title": "Transformation Version",
          "type": "string"
        }
      },
      "required": [
        "model_version",
        "dataset_version",
        "prior_version",
        "transformation_version"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "DeploymentEnvironment": {
      "enum": [
        "FIXTURE",
        "DEVELOPMENT",
        "CLIENT_DEMO",
        "SHADOW",
        "PILOT",
        "PRODUCTION"
      ],
      "title": "DeploymentEnvironment",
      "type": "string"
    },
    "EntitlementContext": {
      "additionalProperties": false,
      "properties": {
        "client_ids": {
          "items": {
            "type": "string"
          },
          "title": "Client Ids",
          "type": "array"
        },
        "environment": {
          "$ref": "#/$defs/DeploymentEnvironment"
        },
        "legal_entities": {
          "items": {
            "type": "string"
          },
          "title": "Legal Entities",
          "type": "array"
        },
        "products": {
          "items": {
            "type": "string"
          },
          "title": "Products",
          "type": "array"
        },
        "regions": {
          "items": {
            "type": "string"
          },
          "title": "Regions",
          "type": "array"
        },
        "roles": {
          "items": {
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        },
        "team": {
          "title": "Team",
          "type": "string"
        },
        "user_id": {
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "roles",
        "team",
        "regions",
        "client_ids",
        "environment"
      ],
      "title": "EntitlementContext",
      "type": "object"
    },
    "EventType": {
      "enum": [
        "EligibilityRecorded",
        "RecommendationAssigned",
        "RecommendationDisplayed",
        "RecommendationOpened",
        "RecommendationDismissed",
        "BankerActionRecorded",
        "PipelineMilestoneRecorded",
        "OutcomeRecorded",
        "EvidenceApproved",
        "AccessDecisionLogged",
        "ShadowWalletReconstructed",
        "LeakageSignalPublished",
        "ActionPortfolioSelected",
        "EvidenceAcquisitionApproved",
        "DecisionBriefCompiled"
      ],
      "title": "EventType",
      "type": "string"
    },
    "EvidenceTier": {
      "enum": [
        "E0",
        "E1",
        "E2",
        "E3",
        "E4"
      ],
      "title": "EvidenceTier",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactReference"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "as_of": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "As Of"
    },
    "assignment_arm": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assignment Arm"
    },
    "assignment_probability": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assignment Probability"
    },
    "censor_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Censor Date"
    },
    "entitlement_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/EntitlementContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "entity_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Entity Id"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "$ref": "#/$defs/EventType"
    },
    "evidence_tier": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceTier"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "product": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Product"
    },
    "rank": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rank"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "recommendation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recommendation Id"
    },
    "rm_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rm Id"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "team_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Team Id"
    }
  },
  "required": [
    "event_id",
    "event_type"
  ],
  "title": "EventEnvelope",
  "type": "object"
}
