{
  "$defs": {
    "ApprovalStatus": {
      "enum": [
        "DRAFT",
        "PENDING_REVIEW",
        "APPROVED",
        "REJECTED",
        "EXPIRED"
      ],
      "title": "ApprovalStatus",
      "type": "string"
    },
    "CuratedMetadata": {
      "additionalProperties": false,
      "properties": {
        "business_key": {
          "title": "Business Key",
          "type": "string"
        },
        "data_owner": {
          "title": "Data Owner",
          "type": "string"
        },
        "entitlement_domain": {
          "title": "Entitlement Domain",
          "type": "string"
        },
        "event_time": {
          "format": "date-time",
          "title": "Event Time",
          "type": "string"
        },
        "ingestion_time": {
          "format": "date-time",
          "title": "Ingestion Time",
          "type": "string"
        },
        "quality_status": {
          "$ref": "#/$defs/QualityStatus",
          "default": "VALID"
        },
        "source_hash": {
          "minLength": 16,
          "title": "Source Hash",
          "type": "string"
        },
        "source_system_key": {
          "title": "Source System Key",
          "type": "string"
        },
        "transformation_version": {
          "title": "Transformation Version",
          "type": "string"
        },
        "valid_from": {
          "format": "date-time",
          "title": "Valid From",
          "type": "string"
        },
        "valid_to": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        }
      },
      "required": [
        "business_key",
        "source_system_key",
        "event_time",
        "valid_from",
        "source_hash",
        "transformation_version",
        "data_owner",
        "entitlement_domain"
      ],
      "title": "CuratedMetadata",
      "type": "object"
    },
    "EvidenceTier": {
      "enum": [
        "E0",
        "E1",
        "E2",
        "E3",
        "E4"
      ],
      "title": "EvidenceTier",
      "type": "string"
    },
    "QualityStatus": {
      "enum": [
        "VALID",
        "QUARANTINED",
        "LEGACY_INCOMPLETE"
      ],
      "title": "QualityStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approval_status": {
      "$ref": "#/$defs/ApprovalStatus"
    },
    "available_date": {
      "format": "date",
      "title": "Available Date",
      "type": "string"
    },
    "bounding_box": {
      "anyOf": [
        {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bounding Box"
    },
    "concept": {
      "title": "Concept",
      "type": "string"
    },
    "currency": {
      "title": "Currency",
      "type": "string"
    },
    "document_hash": {
      "minLength": 16,
      "title": "Document Hash",
      "type": "string"
    },
    "entity_id": {
      "title": "Entity Id",
      "type": "string"
    },
    "extraction_method": {
      "title": "Extraction Method",
      "type": "string"
    },
    "extraction_model_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Extraction Model Version"
    },
    "fact_id": {
      "title": "Fact Id",
      "type": "string"
    },
    "material": {
      "default": false,
      "title": "Material",
      "type": "boolean"
    },
    "metadata": {
      "$ref": "#/$defs/CuratedMetadata"
    },
    "page": {
      "exclusiveMinimum": 0,
      "title": "Page",
      "type": "integer"
    },
    "period_end": {
      "format": "date",
      "title": "Period End",
      "type": "string"
    },
    "period_start": {
      "format": "date",
      "title": "Period Start",
      "type": "string"
    },
    "sign": {
      "maximum": 1,
      "minimum": -1,
      "title": "Sign",
      "type": "integer"
    },
    "source_date": {
      "format": "date",
      "title": "Source Date",
      "type": "string"
    },
    "source_title": {
      "title": "Source Title",
      "type": "string"
    },
    "source_url": {
      "title": "Source Url",
      "type": "string"
    },
    "source_value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "title": "Source Value"
    },
    "supersedes_fact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Fact Id"
    },
    "supporting_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supporting Text"
    },
    "tier": {
      "$ref": "#/$defs/EvidenceTier"
    },
    "unit": {
      "title": "Unit",
      "type": "string"
    }
  },
  "required": [
    "fact_id",
    "entity_id",
    "concept",
    "source_value",
    "currency",
    "unit",
    "sign",
    "period_start",
    "period_end",
    "source_date",
    "available_date",
    "source_title",
    "source_url",
    "document_hash",
    "page",
    "extraction_method",
    "tier",
    "approval_status",
    "metadata"
  ],
  "title": "EvidenceFact",
  "type": "object"
}
