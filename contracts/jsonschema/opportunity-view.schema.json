{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "dataset_version": {
          "title": "Dataset Version",
          "type": "string"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "prior_version": {
          "title": "Prior Version",
          "type": "string"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "rate_card_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate Card Version"
        },
        "schema_version": {
          "default": "v1",
          "title": "Schema Version",
          "type": "string"
        },
        "transformation_version": {
          "title": "Transformation Version",
          "type": "string"
        }
      },
      "required": [
        "model_version",
        "dataset_version",
        "prior_version",
        "transformation_version"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "CalibrationStatus": {
      "enum": [
        "PRIOR_LED",
        "PUBLICLY_ANCHORED",
        "CLIENT_VALIDATED",
        "EMPIRICALLY_CALIBRATED"
      ],
      "title": "CalibrationStatus",
      "type": "string"
    },
    "ClaimClass": {
      "enum": [
        "OBSERVED",
        "IDENTIFIED_BOUND",
        "POSTERIOR",
        "SCENARIO",
        "CAUSAL"
      ],
      "title": "ClaimClass",
      "type": "string"
    },
    "CommercialResult": {
      "additionalProperties": false,
      "properties": {
        "causal_expected_incremental_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "contestable_scenario_contribution": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "net_unit_contribution_bps": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Net Unit Contribution Bps"
        },
        "observed_contribution": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rate_card_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate Card Ref"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/CommercialStatus"
        },
        "target_share": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Share"
        },
        "watermark": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Watermark"
        }
      },
      "required": [
        "status"
      ],
      "title": "CommercialResult",
      "type": "object"
    },
    "CommercialStatus": {
      "enum": [
        "BLOCKED",
        "SIMULATED",
        "APPROVED_SCENARIO",
        "CAUSAL"
      ],
      "title": "CommercialStatus",
      "type": "string"
    },
    "EligibilityState": {
      "enum": [
        "BLOCKED",
        "SHADOW_ONLY",
        "ALLOWED"
      ],
      "title": "EligibilityState",
      "type": "string"
    },
    "EvidenceTier": {
      "enum": [
        "E0",
        "E1",
        "E2",
        "E3",
        "E4"
      ],
      "title": "EvidenceTier",
      "type": "string"
    },
    "IntervalEstimate": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "claim_class": {
          "$ref": "#/$defs/ClaimClass"
        },
        "lower": {
          "minimum": 0,
          "title": "Lower",
          "type": "number"
        },
        "median": {
          "minimum": 0,
          "title": "Median",
          "type": "number"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "nominal_coverage": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Nominal Coverage",
          "type": "number"
        },
        "upper": {
          "minimum": 0,
          "title": "Upper",
          "type": "number"
        }
      },
      "required": [
        "lower",
        "median",
        "upper",
        "nominal_coverage",
        "model_version",
        "as_of",
        "claim_class"
      ],
      "title": "IntervalEstimate",
      "type": "object"
    },
    "Money": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "currency": {
          "maxLength": 3,
          "minLength": 3,
          "title": "Currency",
          "type": "string"
        },
        "fx_policy_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fx Policy Ref"
        },
        "normalized_amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Normalized Amount"
        },
        "normalized_currency": {
          "default": "ZAR",
          "maxLength": 3,
          "minLength": 3,
          "title": "Normalized Currency",
          "type": "string"
        },
        "source_unit": {
          "default": "unit",
          "title": "Source Unit",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency",
        "normalized_amount"
      ],
      "title": "Money",
      "type": "object"
    },
    "RecommendationEligibility": {
      "additionalProperties": false,
      "properties": {
        "evaluated_at": {
          "format": "date-time",
          "title": "Evaluated At",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/EligibilityState"
        }
      },
      "required": [
        "state"
      ],
      "title": "RecommendationEligibility",
      "type": "object"
    },
    "TimingPrediction": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "calibration_status": {
          "title": "Calibration Status",
          "type": "string"
        },
        "event_name": {
          "title": "Event Name",
          "type": "string"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "probability_30d": {
          "maximum": 1,
          "minimum": 0,
          "title": "Probability 30D",
          "type": "number"
        },
        "probability_60d": {
          "maximum": 1,
          "minimum": 0,
          "title": "Probability 60D",
          "type": "number"
        },
        "probability_90d": {
          "maximum": 1,
          "minimum": 0,
          "title": "Probability 90D",
          "type": "number"
        }
      },
      "required": [
        "event_name",
        "probability_30d",
        "probability_60d",
        "probability_90d",
        "method",
        "calibration_status",
        "as_of"
      ],
      "title": "TimingPrediction",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "as_of": {
      "format": "date",
      "title": "As Of",
      "type": "string"
    },
    "calibration_status": {
      "$ref": "#/$defs/CalibrationStatus"
    },
    "commercial": {
      "$ref": "#/$defs/CommercialResult"
    },
    "eligibility": {
      "$ref": "#/$defs/RecommendationEligibility"
    },
    "entity_id": {
      "title": "Entity Id",
      "type": "string"
    },
    "entity_name": {
      "title": "Entity Name",
      "type": "string"
    },
    "evidence_fact_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Fact Ids",
      "type": "array"
    },
    "evidence_tier": {
      "$ref": "#/$defs/EvidenceTier"
    },
    "freshness_days": {
      "minimum": 0,
      "title": "Freshness Days",
      "type": "integer"
    },
    "identification_bounds": {
      "$ref": "#/$defs/IntervalEstimate"
    },
    "observed_activity": {
      "$ref": "#/$defs/Money"
    },
    "opportunity_id": {
      "title": "Opportunity Id",
      "type": "string"
    },
    "posterior_wallet": {
      "$ref": "#/$defs/IntervalEstimate"
    },
    "product": {
      "title": "Product",
      "type": "string"
    },
    "rank": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rank"
    },
    "rank_probability": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rank Probability"
    },
    "sector": {
      "title": "Sector",
      "type": "string"
    },
    "share_claim": {
      "$ref": "#/$defs/ClaimClass"
    },
    "share_interval": {
      "$ref": "#/$defs/IntervalEstimate"
    },
    "timing": {
      "$ref": "#/$defs/TimingPrediction"
    }
  },
  "required": [
    "opportunity_id",
    "entity_id",
    "entity_name",
    "sector",
    "product",
    "as_of",
    "observed_activity",
    "identification_bounds",
    "posterior_wallet",
    "share_interval",
    "share_claim",
    "evidence_tier",
    "calibration_status",
    "freshness_days",
    "timing",
    "commercial",
    "eligibility",
    "artifacts"
  ],
  "title": "OpportunityView",
  "type": "object"
}
