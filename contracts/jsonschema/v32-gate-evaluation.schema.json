{
  "$defs": {
    "DecisionTrack": {
      "description": "Which question a gate evaluation answers.",
      "enum": [
        "REAL",
        "REHEARSAL"
      ],
      "title": "DecisionTrack",
      "type": "string"
    },
    "GateOutcome": {
      "description": "Outcome of evaluating one gate on one track.\n\n``UNKNOWN`` is distinct from ``FAIL``: a gate nobody has evidence for has\nnot been failed, it has not been attempted, and reporting the two the same\nway would either overstate progress or manufacture a failure. ``WAIVED``\ncarries a named approver and is always visible in the register.",
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "NOT_REQUIRED",
        "WAIVED"
      ],
      "title": "GateOutcome",
      "type": "string"
    },
    "PromotionEvidenceMode": {
      "description": "Where a piece of evidence came from, ordered by authority.",
      "enum": [
        "SYNTHETIC_REHEARSAL",
        "PUBLIC_PACKAGE",
        "REAL_BANK",
        "BANK_ATTESTED"
      ],
      "title": "PromotionEvidenceMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One gate, one track, one verdict.\n\nThe type refuses the misrepresentation the whole twin exists to prevent: a\nsynthetic envelope cannot carry a REAL-track PASS.",
  "properties": {
    "envelope_ids": {
      "items": {
        "type": "string"
      },
      "title": "Envelope Ids",
      "type": "array"
    },
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "evidence_mode": {
      "anyOf": [
        {
          "$ref": "#/$defs/PromotionEvidenceMode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "failure_injection_verified": {
      "default": false,
      "title": "Failure Injection Verified",
      "type": "boolean"
    },
    "gate_id": {
      "title": "Gate Id",
      "type": "string"
    },
    "measured_value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Measured Value"
    },
    "outcome": {
      "$ref": "#/$defs/GateOutcome"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "threshold": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Threshold"
    },
    "track": {
      "$ref": "#/$defs/DecisionTrack"
    },
    "transition_id": {
      "title": "Transition Id",
      "type": "string"
    },
    "waived_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Waived By"
    },
    "waiver_rationale": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Waiver Rationale"
    }
  },
  "required": [
    "gate_id",
    "transition_id",
    "track",
    "outcome"
  ],
  "title": "GateEvaluation",
  "type": "object"
}
