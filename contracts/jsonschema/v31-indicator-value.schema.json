{
  "$defs": {
    "ClaimClass": {
      "enum": [
        "OBSERVED",
        "IDENTIFIED_BOUND",
        "POSTERIOR",
        "SCENARIO",
        "CAUSAL"
      ],
      "title": "ClaimClass",
      "type": "string"
    },
    "ComponentStatus": {
      "enum": [
        "SUPPORTED",
        "INFERRED",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "ComponentStatus",
      "type": "string"
    },
    "SignedInterval": {
      "additionalProperties": false,
      "description": "An interval that may be negative.\n\nClient and bank value can legitimately be negative (a cost-to-win exceeding\ncontribution, or an FX position that moves against the client), so the V3\nnon-negative ``AmountInterval`` is not reusable here.",
      "properties": {
        "currency": {
          "default": "ZAR",
          "title": "Currency",
          "type": "string"
        },
        "lower": {
          "title": "Lower",
          "type": "number"
        },
        "median": {
          "title": "Median",
          "type": "number"
        },
        "unit": {
          "default": "ZAR",
          "title": "Unit",
          "type": "string"
        },
        "upper": {
          "title": "Upper",
          "type": "number"
        }
      },
      "required": [
        "lower",
        "median",
        "upper"
      ],
      "title": "SignedInterval",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A transparent, evidence-linked derived indicator.",
  "properties": {
    "claim_class": {
      "$ref": "#/$defs/ClaimClass",
      "default": "IDENTIFIED_BOUND"
    },
    "evidence_claim_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Claim Ids",
      "type": "array"
    },
    "formula": {
      "title": "Formula",
      "type": "string"
    },
    "indicator_id": {
      "title": "Indicator Id",
      "type": "string"
    },
    "inputs": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Inputs",
      "type": "object"
    },
    "interval": {
      "anyOf": [
        {
          "$ref": "#/$defs/SignedInterval"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "label": {
      "title": "Label",
      "type": "string"
    },
    "missing_inputs": {
      "items": {
        "type": "string"
      },
      "title": "Missing Inputs",
      "type": "array"
    },
    "pending_evidence_claim_ids": {
      "items": {
        "type": "string"
      },
      "title": "Pending Evidence Claim Ids",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/ComponentStatus"
    },
    "transformation_version": {
      "title": "Transformation Version",
      "type": "string"
    },
    "unit": {
      "title": "Unit",
      "type": "string"
    }
  },
  "required": [
    "indicator_id",
    "label",
    "formula",
    "unit",
    "status",
    "transformation_version"
  ],
  "title": "IndicatorValue",
  "type": "object"
}
