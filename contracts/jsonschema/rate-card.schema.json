{
  "$defs": {
    "ApprovalStatus": {
      "enum": [
        "DRAFT",
        "PENDING_REVIEW",
        "APPROVED",
        "REJECTED",
        "EXPIRED"
      ],
      "title": "ApprovalStatus",
      "type": "string"
    },
    "CuratedMetadata": {
      "additionalProperties": false,
      "properties": {
        "business_key": {
          "title": "Business Key",
          "type": "string"
        },
        "data_owner": {
          "title": "Data Owner",
          "type": "string"
        },
        "entitlement_domain": {
          "title": "Entitlement Domain",
          "type": "string"
        },
        "event_time": {
          "format": "date-time",
          "title": "Event Time",
          "type": "string"
        },
        "ingestion_time": {
          "format": "date-time",
          "title": "Ingestion Time",
          "type": "string"
        },
        "quality_status": {
          "$ref": "#/$defs/QualityStatus",
          "default": "VALID"
        },
        "source_hash": {
          "minLength": 16,
          "title": "Source Hash",
          "type": "string"
        },
        "source_system_key": {
          "title": "Source System Key",
          "type": "string"
        },
        "transformation_version": {
          "title": "Transformation Version",
          "type": "string"
        },
        "valid_from": {
          "format": "date-time",
          "title": "Valid From",
          "type": "string"
        },
        "valid_to": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        }
      },
      "required": [
        "business_key",
        "source_system_key",
        "event_time",
        "valid_from",
        "source_hash",
        "transformation_version",
        "data_owner",
        "entitlement_domain"
      ],
      "title": "CuratedMetadata",
      "type": "object"
    },
    "QualityStatus": {
      "enum": [
        "VALID",
        "QUARANTINED",
        "LEGACY_INCOMPLETE"
      ],
      "title": "QualityStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "acquisition_cost": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "default": "0",
      "title": "Acquisition Cost"
    },
    "approval_status": {
      "$ref": "#/$defs/ApprovalStatus"
    },
    "approved_hurdle_bps": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "default": "0",
      "title": "Approved Hurdle Bps"
    },
    "capital_bps": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "default": "0",
      "title": "Capital Bps"
    },
    "client_discount_bps": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "default": "0",
      "title": "Client Discount Bps"
    },
    "currency": {
      "default": "ZAR",
      "title": "Currency",
      "type": "string"
    },
    "effective_from": {
      "format": "date",
      "title": "Effective From",
      "type": "string"
    },
    "effective_to": {
      "format": "date",
      "title": "Effective To",
      "type": "string"
    },
    "execution_bps": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "default": "0",
      "title": "Execution Bps"
    },
    "expected_loss_bps": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "default": "0",
      "title": "Expected Loss Bps"
    },
    "ftp_bps": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "default": "0",
      "title": "Ftp Bps"
    },
    "gross_price_bps": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "title": "Gross Price Bps"
    },
    "hedging_bps": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "default": "0",
      "title": "Hedging Bps"
    },
    "liquidity_bps": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "default": "0",
      "title": "Liquidity Bps"
    },
    "metadata": {
      "$ref": "#/$defs/CuratedMetadata"
    },
    "operating_cost_bps": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "default": "0",
      "title": "Operating Cost Bps"
    },
    "owner": {
      "title": "Owner",
      "type": "string"
    },
    "product": {
      "title": "Product",
      "type": "string"
    },
    "rate_card_id": {
      "title": "Rate Card Id",
      "type": "string"
    },
    "reconciliation_status": {
      "title": "Reconciliation Status",
      "type": "string"
    },
    "revenue_driver": {
      "title": "Revenue Driver",
      "type": "string"
    },
    "servicing_bps": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "default": "0",
      "title": "Servicing Bps"
    },
    "synthetic": {
      "title": "Synthetic",
      "type": "boolean"
    },
    "tax_bps": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "default": "0",
      "title": "Tax Bps"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "rate_card_id",
    "version",
    "product",
    "revenue_driver",
    "gross_price_bps",
    "effective_from",
    "effective_to",
    "approval_status",
    "reconciliation_status",
    "synthetic",
    "owner",
    "metadata"
  ],
  "title": "RateCard",
  "type": "object"
}
